@misc{agarwal2022rltheory,
  author = {Agarwal, Alekh and Jiang, Nan and Kakade, Sham M. and Sun, Wen},
  title  = {Reinforcement Learning: Theory and Algorithms},
  year   = {2022},
  note   = {Working draft, version 3, January 31, 2022},
  url    = {https://rltheorybook.github.io/rltheorybook_AJKS_V3.pdf},
  annote = {Verified 2026-10-09. Opened the V3 PDF and the current draft (rltheorybook_ABJKS.pdf, 27 June 2026, which adds K. Brantley as an author).
            Cite: simulation lemma = Lemma 2.2 (an identity: Q^pi - Q^pi_hat = gamma (I - gamma P_hat^pi)^-1 (P - P_hat) V^pi; the horizon factor follows);
            contraction = Lemma 1.10 (s1.3.1). Lemma 1.10 is the contraction of the OPTIMALITY operator on Q. Module 1's T^pi contraction is a one-line argument
            and needs no citation. Bellman optimality = Thm 1.8. Numbering is the same in both versions (academic-director review re-checked V3, 2022-01-31).
            Also opened (academic director, Module 1, 2026-10-10): Lemma 1.4 (Bellman consistency); Cor 1.5 (Q^pi = (I - gamma P^pi)^-1 r,
            with the infinity-norm invertibility argument); Thm 1.7 (a stationary deterministic optimal policy exists); Thm 1.8 (optimality
            equations for Q; the greedy policy w.r.t. Q* is optimal); Lemma 1.11 (greedy-policy loss: V^{pi_Q} >= V* - 2||Q - Q*||_inf/ (1 - gamma),
            no gamma in the numerator; Module 2 cites this).
            CAVEAT: the current draft is updated often, so cite V3.}
}

